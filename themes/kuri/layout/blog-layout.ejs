<!DOCTYPE html>
<html lang="<%= config.language %>">
 <head> 
  <meta charset="utf-8" /> 
  <title><%= page.title ? page.title + ' | ' + config.title : config.title %></title> 
  <link rel="icon" href="<%= theme.fav %>" /> 
  <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
  <meta name="keywords" content="<%= page.tags && page.tags.length ? page.tags.toArray().map(function(t){return t.name}).join(',') : config.keywords %>" />
  <meta name="description" content="<%= page.description || config.description %>" /> 
  <link rel="canonical" href="<%= config.url %>" /> 
  <link rel="stylesheet" href="/css/style.css" /> 
  <link rel="stylesheet" href="/css/mdui.css" importance="high"/> 
  <% if (theme.aplayer.enable) { %>
  <link rel="stylesheet" href="//blog.kuri.ink/lib/aplayer@1.10.0/aplayer.min.css" /> 
  <% } %>
  <script src="//cdn.kuri.ink/js/mdui/mdui.min.js" async></script>
  <style>
   @import url("<%= theme.iconfont %>");
  </style>
 </head> 
 <body> 
   <%- include("_widget/cover.ejs") %>
  <div class="mdui-appbar-with-toolbar mdui-theme-layout-auto mdui-loaded"> 
   <!-- background --> 
   <div id="bg" class="index_bg"></div> 
   <!-- main --> 
   <div>
    <%- include("_partial/blog-header.ejs") %>
   </div> 

   <div class="blog-container">
    <%- include("_partial/sidebar.ejs") %>
    <main class="blog-main">
     <%- blogMain %>
    </main>
   </div>

   <!-- footer --> 
   <div id="footer" class="footer blog-layout-footer"> 
    <p class="remark">
      <%- theme.remark %><br>
      <%- theme.regist %>
      <%- include("_partial/LICENSE.EJS") %>
    </p> 
   </div>  
   <script async="" src="//blog.kuri.ink/lib/aplayer@1.10.0/aplayer.min.js" type="text/javascript"></script> 
   <script async="" src="//blog.kuri.ink/lib/meting/meting.min.js" type="text/javascript"></script>

   <% if (theme.aplayer.enable) { %>
      <meting-js style="position: absolute; z-index:99999;" type="<%= theme.aplayer.type %>" server="<%= theme.aplayer.server %>" id="<%= theme.aplayer.id %>" fixed="<%= theme.aplayer.fixed %>"></meting-js> 
   <% } %>

   <% if (theme.analysis.platform == "51.la") { %>
      <script charset="UTF-8" id="LA_COLLECT" src="//sdk.51.la/js-sdk-pro.min.js"></script>
      <script>LA.init({id: "<%= theme.analysis.id %>",ck: "<%= theme.analysis.cd %>"})</script>
   <% } %>
  </div>
 </body>
</html>

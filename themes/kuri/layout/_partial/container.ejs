<div id="container" class="container"> 
    <div class="card"> 
     <div id="card-content" class="card-content"> 
      <center>
       <div class="logo"></div>
       <style>
        .logo {
	        width: 100px;
	        height: 100px;
	        margin-top: -50px;
	        border:1px soild white;
	        background: url('<%= theme.logo %>') no-repeat center;
	        border-radius: 50px;
	        background-size: 100px;
        }
       </style>
      </center> 
      <b class="nickname"><%= theme.nickname %></b> 
      <br /> 
      <b class="motto"><%= theme.motto %></b> 
     </div> 
    </div> 

    <div class="card" style="margin-top: 1%;"> 
     <div id="card-content" class="card-content"> 
      <div class="social">
        <% for (a in theme.social) { %> 
        <a href="<%= theme.social[a][0] %>" target="_blank"><button class="mdui-btn mdui-btn-icon" mdui-tooltip="{content: '<%= theme.social[a][1] %>'}"><% if (theme.social[a][2] === 'iconheart') { %><svg class="jump-heart" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg><% } else { %><span class="<%= theme.social[a][2] %>"></span><% } %></button></a>
       <% } %>
      </div> 
     </div> 
    </div> 

   </div> 

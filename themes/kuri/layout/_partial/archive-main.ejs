<div class="archive">
 <h1 class="archive-title"><%= page.year ? page.year + (page.month ? '/' + page.month : '') + ' 归档' : '博客归档' %></h1>
 <% page.posts.each(function(post){ %>
 <article class="archive-item">
  <time class="archive-date" datetime="<%= date_xml(post.date) %>"><%= date(post.date, config.date_format) %></time>
  <h2 class="archive-item-title"><a href="<%= url_for(post.path) %>"><%= post.title %></a></h2>
  <% if (post.excerpt) { %><div class="archive-excerpt"><%- post.excerpt %></div><% } %>
 </article>
 <% }) %>
 <% if (page.prev || page.next) { %>
 <nav class="archive-pagination">
  <% if (page.prev) { %><a href="<%= url_for(page.prev.path) %>">← 上一页</a><% } %>
  <% if (page.next) { %><a href="<%= url_for(page.next.path) %>">下一页 →</a><% } %>
 </nav>
 <% } %>
</div>

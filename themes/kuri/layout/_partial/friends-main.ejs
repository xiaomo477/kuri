<article class="post page">
 <h1 class="post-title"><%= page.title %></h1>
 <div class="post-content"><%- page.content %></div>
 <% if (theme.friends && theme.friends.length) { %>
 <div class="friend-list">
  <% theme.friends.forEach(function(friend) { %>
  <a class="friend-card" href="<%= friend.link %>" target="_blank" rel="noopener">
   <img class="friend-card-avatar" src="<%= friend.avatar %>" alt="<%= friend.name %>" loading="lazy" onerror="this.src='/images/avatar.jpg'" />
   <div class="friend-card-body">
    <h3 class="friend-card-name"><%= friend.name %></h3>
    <p class="friend-card-desc"><%= friend.desc %></p>
   </div>
  </a>
  <% }) %>
 </div>
 <% } %>
 <%- partial('_partial/comments') %>
</article>

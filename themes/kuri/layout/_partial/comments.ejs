<% if (theme.comment && theme.comment.enable && theme.comment.platform === 'waline') { %>
<div id="comments" class="post-comments">
  <h2 class="post-comments-title">评论</h2>
  <div id="waline"></div>
  <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
  <script type="module">
    import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
    init({
      el: '#waline',
      serverURL: '<%= theme.comment.server_url %>',
      lang: '<%= theme.comment.lang || 'zh-CN' %>',
      dark: '<%= theme.comment.dark || 'auto' %>',
      pageview: <%= theme.comment.pageview ? 'true' : 'false' %>,
      // cn.cravatar.com 是当前官方正式域名；cravatar.cn 已 301 重定向到该域名，但部分浏览器/网络环境跟随重定向会失败
      avatarCDN: 'https://cn.cravatar.com/avatar/',
      // 未注册 Cravatar 的访客统一回退默认头像，可在 _config.kuri.yml 的 comment.default_avatar 修改
      defaultAvatar: '<%= theme.comment.default_avatar || "mp" %>'<% if (theme.comment.emoji && theme.comment.emoji.length) { %>,
      emoji: <%- JSON.stringify(theme.comment.emoji) %><% } %>
    });
  </script>
</div>
<% } %>

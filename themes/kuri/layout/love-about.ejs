---
layout: false
---
<%
  var love = theme.love || {};
  var site = love.site || {};
  var about = love.about || {};
  var dialog = (about.dialog || []).filter(function (d) { return d && String(d).trim(); });
  var buttons = (about.buttons || []).filter(function (b) { return b && b.text; });
  var aboutBg = about.background || '';

  function pad2(n) { return (n < 10 ? '0' : '') + n; }
  var raw = love.together_since;
  if (raw instanceof Date) {
    raw = raw.getFullYear() + '-' + pad2(raw.getMonth() + 1) + '-' + pad2(raw.getDate());
  }
  var m = /^(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T](\d{1,2}):(\d{1,2})(?::(\d{1,2}))?)?/.exec(String(raw || ''));
  var sinceText = m
    ? m[1] + '-' + pad2(+m[2]) + '-' + pad2(+m[3]) + ' ' + pad2(+(m[4] || 0)) + ':' + pad2(+(m[5] || 0)) + ':' + pad2(+(m[6] || 0))
    : '2026-10-23 21:55:00';
%><!DOCTYPE html>
<html lang="<%= config.language %>">
 <head>
  <meta charset="utf-8" />
  <title><%= page.title || '关于我们' %></title>
  <link rel="icon" href="<%= theme.fav %>" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <link rel="stylesheet" href="/css/love-src.css" />
 </head>
 <body class="lovepage">

  <header class="lp-header">
   <div class="lp-header-in">
    <div class="lp-logo"><a href="/success/"><%= site.name || '小哞和小罐' %></a></div>
    <div class="lp-word">在一起的第 <span data-love-days data-since="<%= sinceText %>"><b data-love-days-num>1</b></span> 天</div>
   </div>
  </header>

  <main class="lp-central lp-central-800">
   <p class="lp-title" style="margin-bottom:1rem">
    <span style="font-size:1.6rem;font-weight:700;color:#646161">与 <i style="font-style:normal;color:#a1a1a1;margin:0 .5rem"><%= about.title || (site.name || '小站') %></i> 对话中...</span>
   </p>

   <div class="lp-about-stage"<% if (aboutBg) { %> style="--lp-about-bg:url('<%= aboutBg %>')"<% } %>>
    <div class="lp-chat" id="lp-chat"></div>
    <div class="lp-actions" id="lp-actions"></div>
   </div>

   <footer class="lp-foot">
    <p><b><%= site.name || '小哞和小罐' %></b> · <%= site.writing || '喜欢花 喜欢海 喜欢你~' %></p>
   </footer>
  </main>

  <script id="lp-about-data" type="application/json"><%- JSON.stringify({ dialog: dialog, buttons: buttons }).replace(/</g, '\\u003c') %></script>
  <script src="/js/love-about.js" defer></script>
  <script src="/js/love-days.js" defer></script>
 </body>
</html>

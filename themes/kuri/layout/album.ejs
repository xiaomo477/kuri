---
layout: false
---
<%
  var love = theme.love || {};
  var site = love.site || {};

  function pad2(n) { return (n < 10 ? '0' : '') + n; }

  var raw = love.together_since;
  if (raw instanceof Date) {
    raw = raw.getFullYear() + '-' + pad2(raw.getMonth() + 1) + '-' + pad2(raw.getDate());
  }
  var m = /^(\d{4})-(\d{1,2})-(\d{1,2})(?:[ T](\d{1,2}):(\d{1,2})(?::(\d{1,2}))?)?/.exec(String(raw || ''));
  var sinceText = m
    ? m[1] + '-' + pad2(+m[2]) + '-' + pad2(+m[3]) + ' ' + pad2(+(m[4] || 0)) + ':' + pad2(+(m[5] || 0)) + ':' + pad2(+(m[6] || 0))
    : '2026-10-23 21:55:00';

  // 日期统一显示成 2026.10.23
  function dateText(v) {
    if (!v && v !== 0) return '';
    var y, mo, d;
    if (v instanceof Date) {
      y = v.getFullYear(); mo = v.getMonth() + 1; d = v.getDate();
    } else {
      var mm = /^(\d{4})-(\d{1,2})-(\d{1,2})/.exec(String(v));
      if (!mm) return String(v);
      y = +mm[1]; mo = +mm[2]; d = +mm[3];
    }
    return y + '.' + pad2(mo) + '.' + pad2(d);
  }

  function typeOfSrc(src) {
    return /\.(mp4|webm|ogv|mov|m4v)(\?.*)?$/i.test(String(src || '')) ? 'video' : 'image';
  }

  // 判断「这张图属于哪个分组」时用的键：统一解码，避免配置里写中文、
  // 扫描出来是 %E6%98%9F… 编码串，两边对不上导致同一张图重复出现
  function keyOf(src) {
    var name = String(src || '').split('#')[0].split('/').pop();
    try { name = decodeURIComponent(name); } catch (e) {}
    return name;
  }

  // 图注只认手写的字：优先取照片自己的 caption，其次查 love.captions 里按文件名登记的那句，
  // 都没有就空着。绝不拿文件名凑数，页面上不会冒出 mmexport1792… 这种名字
  var capMap = (love.captions && typeof love.captions === 'object') ? love.captions : {};
  function captionFor(p, src) {
    var own = p && (p.caption || p.text);
    if (own) return own;
    var byName = capMap[keyOf(src)];
    return byName ? byName : '';
  }

  function normPhoto(p) {
    if (typeof p === 'string') {
      return p ? { src: p, caption: captionFor(null, p), type: typeOfSrc(p) } : null;
    }
    if (p && typeof p === 'object') {
      var src = p.img || p.src || p.url || '';
      if (!src) return null;
      return { src: src, caption: captionFor(p, src), type: typeOfSrc(src) };
    }
    return null;
  }

  // 配置里的分组
  var groups = [];
  var rawAlbum = Array.isArray(love.album) ? love.album : [];
  rawAlbum.forEach(function (g) {
    if (!g) return;
    var items = (Array.isArray(g.photos) ? g.photos : []).map(normPhoto).filter(Boolean);
    groups.push({
      dateText: dateText(g.date),
      title: g.title || '',
      desc: g.desc || '',
      items: items
    });
  });

  // 没配置分组时，退回自动扫描 source/images/love/
  var auto = typeof love_photos === 'function' ? love_photos() : [];
  var used = {};
  groups.forEach(function (g) {
    g.items.forEach(function (it) {
      used[keyOf(it.src)] = 1;
    });
  });

  if (!groups.length) {
    if (auto.length) {
      groups.push({
        dateText: '',
        title: '',
        desc: '',
        items: auto.map(function (p) { return { src: p.src, caption: '', type: p.type }; })
      });
    }
  } else {
    // 配置了分组，但目录里还有没归类的照片：单独收进「还没分组」，避免放了图却看不见
    var loose = auto.filter(function (p) {
      return !used[keyOf(p.src)];
    }).map(function (p) {
      return { src: p.src, caption: '', type: p.type };
    });
    if (loose.length) {
      groups.push({
        dateText: '',
        title: '还没分组',
        desc: '把照片路径填进 _config.kuri.yml 的 love.album 对应分组，就会挪到上面去',
        items: loose
      });
    }
  }

  // 摊平成一个数组，供大图查看用；每组照片记住自己在大数组里的下标
  var photos = [];
  groups.forEach(function (g) {
    g.items.forEach(function (it) {
      it.idx = photos.length;
      photos.push({ src: it.src, caption: it.caption, type: it.type || 'image' });
    });
  });
  var videoCount = photos.filter(function (p) { return p.type === 'video'; }).length;
%><!DOCTYPE html>
<html lang="<%= config.language %>">
 <head>
  <meta charset="utf-8" />
  <title><%= page.title || '恋爱相册' %></title>
  <link rel="icon" href="<%= theme.fav %>" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <link rel="stylesheet" href="/css/love-src.css" />
 </head>
 <body class="lovepage">

  <header class="lp-header">
   <div class="lp-header-in">
    <div class="lp-logo"><a href="/success/"><%= site.name || '小哞和小罐' %></a></div>
    <div class="lp-word">在一起的第 <span data-love-days data-since="<%= sinceText %>"><b data-love-days-num>1</b></span> 天</div>
   </div>
  </header>

  <main class="lp-central">
   <div class="lp-title">
    <h1>把日子过成照片</h1>
   </div>

<% if (!photos.length) { %>
   <div class="lp-gallery-empty">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3 7.2 5H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-3.2L15 3H9zm3 5.5A5.5 5.5 0 1 1 6.5 14 5.5 5.5 0 0 1 12 8.5zm0 2A3.5 3.5 0 1 0 15.5 14 3.5 3.5 0 0 0 12 10.5z"/></svg>
    <b>相册还空着</b>
    <p>在 <code>_config.kuri.yml</code> 的 <code>love.album</code> 里按时间和事件分好组</p>
    <p>把照片放进 <code>source/images/love/</code> 再填进来</p>
   </div>
<% } else { %>
   <div class="lp-album">
<% groups.forEach(function (g) { %>
    <section class="lp-album-group">
<% if (g.dateText || g.title) { %>
     <header class="lp-album-head">
<% if (g.dateText) { %>
      <span class="lp-album-date"><%= g.dateText %></span>
<% } %>
<% if (g.title) { %>
      <h2 class="lp-album-event"><%= g.title %></h2>
<% } %>
     </header>
<% } %>
<% if (g.desc) { %>
     <p class="lp-album-desc"><%= g.desc %></p>
<% } %>
<% if (g.items.length) { %>
     <div class="lp-gallery">
<% g.items.forEach(function (it) { %>
<% var isVideo = it.type === 'video'; %>
      <div class="lp-shot<%= isVideo ? ' is-video' : '' %>" data-index="<%= it.idx %>" data-type="<%= isVideo ? 'video' : 'image' %>" role="button" tabindex="0" aria-label="<%= isVideo ? '播放' : '查看' %> <%= it.caption || (isVideo ? '视频' : '照片') %>">
<% if (isVideo) { %>
       <span class="lp-shot-media">
        <video src="<%= it.src %>#t=0.1" preload="metadata" muted playsinline webkit-playsinline></video>
        <span class="lp-shot-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.14v13.72L19 12z"/></svg></span>
       </span>
<% } else { %>
       <img src="<%= it.src %>" alt="<%= it.caption || '' %>" loading="lazy" />
<% } %>
<% if (it.caption) { %>
       <span><%= it.caption %></span>
<% } %>
      </div>
<% }); %>
     </div>
<% } %>
    </section>
<% }); %>
   </div>

   <div class="lp-viewer" hidden>
    <img class="lp-viewer-img" src="" alt="" />
    <video class="lp-viewer-video" src="" controls playsinline webkit-playsinline preload="none" hidden></video>
    <button class="lp-viewer-btn lp-viewer-close" type="button" aria-label="关闭">
     <svg viewBox="0 0 24 24"><path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </button>
    <button class="lp-viewer-btn lp-viewer-prev" type="button" aria-label="上一张">
     <svg viewBox="0 0 24 24"><path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
    </button>
    <button class="lp-viewer-btn lp-viewer-next" type="button" aria-label="下一张">
     <svg viewBox="0 0 24 24"><path d="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z"/></svg>
    </button>
    <p class="lp-viewer-cap"></p>
    <p class="lp-viewer-note" hidden>这个视频是 HEVC（H.265）编码，Chrome / Edge 默认解不了。用 Safari 打开，或把视频转成 H.264 再放进来。</p>
   </div>

   <script id="lp-photo-data" type="application/json"><%- JSON.stringify(photos).replace(/</g, '\\u003c') %></script>
   <script src="/js/love-album.js" defer></script>
<% } %>

   <footer class="lp-foot">
    <p><b><%= site.name || '小哞和小罐' %></b> · <%= photos.length ? photos.length - videoCount + ' 张照片' + (videoCount ? ' · ' + videoCount + ' 个视频' : '') : '未完待续' %></p>
   </footer>
  </main>

  <script src="/js/love-days.js" defer></script>
 </body>
</html>
